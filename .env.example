# Copy to .env and adjust as needed. No real secrets are committed here.

# Inside docker compose, use the postgres service on its internal port 5432.
# From the host machine (e.g. running scripts/tests locally), use localhost:5433
# (mapped in docker-compose.yml to avoid colliding with any local Postgres on 5432).
DATABASE_URL=postgresql+psycopg2://pipelinemedic:pipelinemedic@postgres:5432/pipelinemedic
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# mock | openai | azure_openai  (only "mock" is verified end-to-end in this repo)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081

APP_ENV=development
LOG_LEVEL=INFO
LAG_WARNING_THRESHOLD=500
LAG_CRITICAL_THRESHOLD=5000

# Fault-injection producer scenario: normal | schema_drift | poison | lag
SCENARIO=normal
RATE_PER_SEC=2

# Notifications (see backend/app/services/notifications.py).
# console (default): logs a structured message, no credentials needed.
# smtp: sends REAL email via smtplib -- requires your own SMTP credentials
# below to actually deliver mail (not demonstrated with a real mailbox in
# this repo; see docs/safety-model.md).
NOTIFICATION_CHANNEL=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDR=
SMTP_TO_ADDR=
SMTP_USE_TLS=true

# Approve-link tokens (see backend/app/services/approval_tokens.py).
# CHANGE this secret outside local development -- it signs single-use,
# time-limited approve-link tokens (itsdangerous), which are the only
# credential gating the /approve-link/{token} flow.
APPROVAL_TOKEN_SECRET=dev-insecure-secret-change-me
APPROVAL_TOKEN_MAX_AGE_SECONDS=1800
# Where the dashboard actually runs (Vite dev server default is 5173).
DASHBOARD_BASE_URL=http://localhost:5173

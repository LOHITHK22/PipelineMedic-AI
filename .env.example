# Copy to .env and adjust as needed. No real secrets are committed here.

# Inside docker compose, use the postgres service on its internal port 5432.
# From the host machine (e.g. running scripts/tests locally), use localhost:5433
# (mapped in docker-compose.yml to avoid colliding with any local Postgres on 5432).
DATABASE_URL=postgresql+psycopg2://pipelinemedic:pipelinemedic@postgres:5432/pipelinemedic
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# mock | openai | azure_openai  (only "mock" is verified end-to-end in this repo)
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

FLINK_JOBMANAGER_URL=http://flink-jobmanager:8081

APP_ENV=development
LOG_LEVEL=INFO
LAG_WARNING_THRESHOLD=500
LAG_CRITICAL_THRESHOLD=5000

# Fault-injection producer scenario: normal | schema_drift | poison | lag
SCENARIO=normal
RATE_PER_SEC=2
